+    /// A powered-off machine can only be woken from its own LAN, so the magic packet request goes
+    /// to the online peers registered from the public IP it was last seen at.
+    async fn handle_wake_request(
+        &mut self,
+        stream: &mut FramedStream,
+        pd: PeerDiscovery,
+    ) -> ResultType<()> {
+        let mut helpers = 0;
+        if let Some(target) = self.pm.get(&pd.id).await {
+            let ip = {
+                let p = target.read().await;
+                if p.socket_addr.port() != 0 {
+                    Some(p.socket_addr.ip())
+                } else {
+                    p.info.ip.parse::<IpAddr>().ok()
+                }
+            };
+            if let Some(ip) = ip {
+                let mut msg_out = RendezvousMessage::new();
+                msg_out.set_peer_discovery(PeerDiscovery {
+                    cmd: "wol".to_owned(),
+                    mac: pd.mac,
+                    ..Default::default()
+                });
+                for addr in self.pm.online_at(ip, &pd.id, REG_TIMEOUT).await {
+                    self.tx.send(Data::Msg(msg_out.clone().into(), addr)).ok();
+                    helpers += 1;
+                }
+            }
+        }
+        log::info!("wake request for {}: {} helper(s)", pd.id, helpers);
+        let mut msg_out = RendezvousMessage::new();
+        msg_out.set_peer_discovery(PeerDiscovery {
+            cmd: "wol".to_owned(),
+            misc: helpers.to_string(),
+            ..Default::default()
+        });
+        stream.send(&msg_out).await?;
+        Ok(())
+    }
