+    /// Addresses of up to 8 peers other than `except` registered from `ip` within `timeout_ms`.
+    pub(crate) async fn online_at(
+        &self,
+        ip: std::net::IpAddr,
+        except: &str,
+        timeout_ms: i64,
+    ) -> Vec<SocketAddr> {
+        let peers: Vec<LockPeer> = self
+            .map
+            .read()
+            .await
+            .iter()
+            .filter(|(id, _)| id.as_str() != except)
+            .map(|(_, p)| p.clone())
+            .collect();
+        let mut addrs = Vec::new();
+        for p in peers {
+            let p = p.read().await;
+            if (p.last_reg_time.elapsed().as_millis() as i64) < timeout_ms
+                && p.socket_addr.ip().to_canonical() == ip.to_canonical()
+            {
+                addrs.push(p.socket_addr);
+                if addrs.len() >= 8 {
+                    break;
+                }
+            }
+        }
+        addrs
+    }
